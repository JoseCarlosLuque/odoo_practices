<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_cd_library_loan_wizard_form" model="ir.ui.view">
            <field name="name">cd.library.loan.wizard.form</field>
            <field name="model">cd.library.loan.wizard</field>
            <field name="arch" type="xml">
                <form string="Nuevo préstamo">
                    <group>
                        <field name="book_id"/>
                        <field name="partner_id"/>
                        <field name="loan_date"/>
                        <field name="due_date"/>
                    </group>
                    <footer>
                        <button name="action_create_loan"
                                type="object"
                                string="Crear préstamo"
                                class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_cd_library_loan_wizard" model="ir.actions.act_window">
            <field name="name">Nuevo préstamo</field>
            <field name="res_model">cd.library.loan.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
