<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="demo_partner_ana" model="res.partner">
            <field name="name">Ana Biblioteca</field>
            <field name="email">ana.biblioteca@example.com</field>
        </record>

        <record id="demo_partner_bruno" model="res.partner">
            <field name="name">Bruno Biblioteca</field>
            <field name="email">bruno.biblioteca@example.com</field>
        </record>

        <record id="demo_genre_novela" model="cd.library.genre">
            <field name="name">Novela</field>
            <field name="color">1</field>
        </record>

        <record id="demo_genre_misterio" model="cd.library.genre">
            <field name="name">Misterio</field>
            <field name="color">4</field>
        </record>

        <record id="demo_book_quijote" model="cd.library.book">
            <field name="name">El Quijote</field>
            <field name="description">Un clásico para practicar dominios y recordsets.</field>
            <field name="author_id" ref="demo_partner_ana"/>
            <field name="genre_ids" eval="[(6, 0, [ref('demo_genre_novela'), ref('demo_genre_misterio')])]"/>
            <field name="replacement_cost">25.0</field>
            <field name="quantity">2</field>
            <field name="state">available</field>
        </record>

        <record id="demo_book_clean_code" model="cd.library.book">
            <field name="name">Clean Code</field>
            <field name="description">Ideal para escribir muchos search().</field>
            <field name="author_id" ref="demo_partner_bruno"/>
            <field name="genre_ids" eval="[(6, 0, [ref('demo_genre_novela')])]"/>
            <field name="replacement_cost">80.0</field>
            <field name="quantity">1</field>
            <field name="state">loaned</field>
        </record>

        <record id="demo_book_orm" model="cd.library.book">
            <field name="name">Dominios y recordsets</field>
            <field name="author_id" ref="demo_partner_ana"/>
            <field name="replacement_cost">150.0</field>
            <field name="quantity">3</field>
            <field name="state">draft</field>
        </record>

        <record id="demo_copy_quijote_1" model="cd.library.copy">
            <field name="name">EJ-0001</field>
            <field name="book_id" ref="demo_book_quijote"/>
            <field name="condition">good</field>
            <field name="acquisition_price">20.0</field>
        </record>

        <record id="demo_loan_ana" model="cd.library.loan">
            <field name="name">Préstamo de Ana</field>
            <field name="book_id" ref="demo_book_quijote"/>
            <field name="partner_id" ref="demo_partner_ana"/>
            <field name="loan_date" eval="datetime.today().date()"/>
            <field name="due_date" eval="datetime.today().date() + timedelta(days=7)"/>
            <field name="state">ongoing</field>
        </record>

        <record id="demo_loan_bruno" model="cd.library.loan">
            <field name="name">Préstamo de Bruno</field>
            <field name="book_id" ref="demo_book_clean_code"/>
            <field name="partner_id" ref="demo_partner_bruno"/>
            <field name="loan_date" eval="datetime.today().date() - timedelta(days=10)"/>
            <field name="due_date" eval="datetime.today().date() - timedelta(days=3)"/>
            <field name="state">returned</field>
        </record>
    </data>
</odoo>
