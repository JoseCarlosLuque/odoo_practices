<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="demo_partner_ana" model="res.partner">
            <field name="name">Ana Carpintería</field>
            <field name="email">ana.carpinteria@example.com</field>
        </record>

        <record id="demo_partner_bruno" model="res.partner">
            <field name="name">Bruno Carpintería</field>
            <field name="email">bruno.carpinteria@example.com</field>
        </record>

        <record id="demo_material_roble" model="cd.furniture.material">
            <field name="name">Roble</field>
            <field name="color">1</field>
        </record>

        <record id="demo_material_pino" model="cd.furniture.material">
            <field name="name">Pino</field>
            <field name="color">4</field>
        </record>

        <record id="demo_product_mesa" model="cd.furniture.product">
            <field name="name">Mesa de roble</field>
            <field name="description">Un mueble ideal para practicar dominios y recordsets.</field>
            <field name="designer_id" ref="demo_partner_ana"/>
            <field name="material_ids" eval="[(6, 0, [ref('demo_material_roble')])]"/>
            <field name="price">25.0</field>
            <field name="quantity">2</field>
            <field name="state">available</field>
        </record>

        <record id="demo_product_silla" model="cd.furniture.product">
            <field name="name">Silla de pino</field>
            <field name="description">Ideal para escribir muchos search().</field>
            <field name="designer_id" ref="demo_partner_bruno"/>
            <field name="material_ids" eval="[(6, 0, [ref('demo_material_pino')])]"/>
            <field name="price">80.0</field>
            <field name="quantity">1</field>
            <field name="state">in_production</field>
        </record>

        <record id="demo_product_armario" model="cd.furniture.product">
            <field name="name">Armario</field>
            <field name="designer_id" ref="demo_partner_ana"/>
            <field name="price">150.0</field>
            <field name="quantity">3</field>
            <field name="state">draft</field>
        </record>

        <record id="demo_component_mesa" model="cd.furniture.component">
            <field name="name">Tablero superior</field>
            <field name="product_id" ref="demo_product_mesa"/>
            <field name="quantity">1</field>
            <field name="price_unit">30.0</field>
        </record>

        <record id="demo_workorder_ana" model="cd.furniture.workorder">
            <field name="name">Orden de Ana</field>
            <field name="product_id" ref="demo_product_mesa"/>
            <field name="partner_id" ref="demo_partner_ana"/>
            <field name="date_start" eval="datetime.today().date()"/>
            <field name="date_end" eval="datetime.today().date() + timedelta(days=7)"/>
            <field name="state">ongoing</field>
        </record>

        <record id="demo_workorder_bruno" model="cd.furniture.workorder">
            <field name="name">Orden de Bruno</field>
            <field name="product_id" ref="demo_product_silla"/>
            <field name="partner_id" ref="demo_partner_bruno"/>
            <field name="date_start" eval="datetime.today().date() - timedelta(days=10)"/>
            <field name="date_end" eval="datetime.today().date() - timedelta(days=3)"/>
            <field name="state">done</field>
        </record>
    </data>
</odoo>
