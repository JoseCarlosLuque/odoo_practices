<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vistas del modelo cd.furniture.workorder. Vienen funcionando; el
             EJERCICIO 33 te pide descomentar el chatter cuando heredes de
             mail.thread. -->
        <record id="view_cd_furniture_workorder_list" model="ir.ui.view">
            <field name="name">cd.furniture.workorder.list</field>
            <field name="model">cd.furniture.workorder</field>
            <field name="arch" type="xml">
                <list string="Órdenes">
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="partner_id"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_cd_furniture_workorder_form" model="ir.ui.view">
            <field name="name">cd.furniture.workorder.form</field>
            <field name="model">cd.furniture.workorder</field>
            <field name="arch" type="xml">
                <form string="Orden">
                    <header>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="product_id"/>
                                <field name="partner_id"/>
                            </group>
                            <group>
                                <field name="date_start"/>
                                <field name="date_end"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notas" name="note">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                    <!-- =====================================================
                         EJERCICIO 33 · Bloque 6
                         Cuando añadas _inherit = ['mail.thread',
                         'mail.activity.mixin'] al modelo, descomenta esta
                         línea para mostrar el chatter:

                         <chatter/>
                         ===================================================== -->
                </form>
            </field>
        </record>

        <record id="action_cd_furniture_workorder" model="ir.actions.act_window">
            <field name="name">Órdenes</field>
            <field name="res_model">cd.furniture.workorder</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
