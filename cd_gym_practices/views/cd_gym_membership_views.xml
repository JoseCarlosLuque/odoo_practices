<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vistas del modelo cd.gym.membership. Vienen funcionando; el
             EJERCICIO 28 te pide añadir un botón en el header. -->
        <record id="view_cd_gym_membership_list" model="ir.ui.view">
            <field name="name">cd.gym.membership.list</field>
            <field name="model">cd.gym.membership</field>
            <field name="arch" type="xml">
                <list string="Cuotas">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="activity_ids" widget="many2many_tags"/>
                    <field name="price"/>
                    <field name="quantity"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_cd_gym_membership_form" model="ir.ui.view">
            <field name="name">cd.gym.membership.form</field>
            <field name="model">cd.gym.membership</field>
            <field name="arch" type="xml">
                <form string="Cuota">
                    <header>
                        <!-- =================================================
                             EJERCICIO 28b · Bloque 4
                             Añade aquí un botón que llame al método
                             action_mark_active y que solo se vea cuando el
                             estado sea 'draft'. Ejemplo de sintaxis:

                             <button name="action_mark_active"
                                     type="object"
                                     string="Marcar activa"
                                     invisible="state != 'draft'"/>
                             ================================================= -->
                        <field name="state" widget="statusbar" statusbar_visible="draft,active,frozen"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_booking_wizard"
                                    type="object"
                                    string="Reservar"
                                    class="oe_stat_button"
                                    icon="fa-calendar"/>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="activity_ids" widget="many2many_tags"/>
                                <field name="start_date"/>
                            </group>
                            <group>
                                <field name="price"/>
                                <field name="quantity"/>
                                <field name="currency_id" groups="base.group_multi_currency"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Descripción" name="description">
                                <field name="description"/>
                            </page>
                            <page string="Servicios" name="services">
                                <field name="service_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="quantity"/>
                                        <field name="price_unit"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Reservas" name="bookings">
                                <field name="booking_ids">
                                    <list>
                                        <field name="name"/>
                                        <field name="partner_id"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_cd_gym_membership_search" model="ir.ui.view">
            <field name="name">cd.gym.membership.search</field>
            <field name="model">cd.gym.membership</field>
            <field name="arch" type="xml">
                <search string="Buscar cuotas">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="activity_ids"/>
                    <filter name="filter_draft" string="Borradores" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_active" string="Activas" domain="[('state', '=', 'active')]"/>
                    <group>
                        <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                        <filter name="group_partner" string="Socio" context="{'group_by': 'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_cd_gym_membership" model="ir.actions.act_window">
            <field name="name">Cuotas</field>
            <field name="res_model">cd.gym.membership</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_cd_gym_membership_search"/>
        </record>
    </data>
</odoo>
