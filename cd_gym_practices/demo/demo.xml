<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="demo_partner_ana" model="res.partner">
            <field name="name">Ana Gimnasio</field>
            <field name="email">ana.gimnasio@example.com</field>
        </record>

        <record id="demo_partner_bruno" model="res.partner">
            <field name="name">Bruno Gimnasio</field>
            <field name="email">bruno.gimnasio@example.com</field>
        </record>

        <record id="demo_activity_yoga" model="cd.gym.activity">
            <field name="name">Yoga</field>
            <field name="color">1</field>
        </record>

        <record id="demo_activity_crossfit" model="cd.gym.activity">
            <field name="name">Crossfit</field>
            <field name="color">4</field>
        </record>

        <record id="demo_membership_mensual" model="cd.gym.membership">
            <field name="name">Cuota mensual</field>
            <field name="description">Una cuota ideal para practicar dominios y recordsets.</field>
            <field name="partner_id" ref="demo_partner_ana"/>
            <field name="activity_ids" eval="[(6, 0, [ref('demo_activity_yoga')])]"/>
            <field name="price">25.0</field>
            <field name="quantity">2</field>
            <field name="state">active</field>
        </record>

        <record id="demo_membership_premium" model="cd.gym.membership">
            <field name="name">Cuota premium</field>
            <field name="description">Ideal para escribir muchos search().</field>
            <field name="partner_id" ref="demo_partner_bruno"/>
            <field name="activity_ids" eval="[(6, 0, [ref('demo_activity_crossfit')])]"/>
            <field name="price">80.0</field>
            <field name="quantity">1</field>
            <field name="state">frozen</field>
        </record>

        <record id="demo_membership_basica" model="cd.gym.membership">
            <field name="name">Cuota básica</field>
            <field name="partner_id" ref="demo_partner_ana"/>
            <field name="price">150.0</field>
            <field name="quantity">3</field>
            <field name="state">draft</field>
        </record>

        <record id="demo_service_mensual" model="cd.gym.membership.line">
            <field name="name">Entrenamiento personal</field>
            <field name="membership_id" ref="demo_membership_mensual"/>
            <field name="quantity">1</field>
            <field name="price_unit">30.0</field>
        </record>

        <record id="demo_booking_ana" model="cd.gym.booking">
            <field name="name">Reserva de Ana</field>
            <field name="membership_id" ref="demo_membership_mensual"/>
            <field name="partner_id" ref="demo_partner_ana"/>
            <field name="date_start" eval="datetime.today().date()"/>
            <field name="date_end" eval="datetime.today().date() + timedelta(days=7)"/>
            <field name="state">ongoing</field>
        </record>

        <record id="demo_booking_bruno" model="cd.gym.booking">
            <field name="name">Reserva de Bruno</field>
            <field name="membership_id" ref="demo_membership_premium"/>
            <field name="partner_id" ref="demo_partner_bruno"/>
            <field name="date_start" eval="datetime.today().date() - timedelta(days=10)"/>
            <field name="date_end" eval="datetime.today().date() - timedelta(days=3)"/>
            <field name="state">done</field>
        </record>
    </data>
</odoo>
