<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="demo_partner_ana" model="res.partner">
            <field name="name">Ana Práctica</field>
            <field name="email">ana.practica@example.com</field>
        </record>

        <record id="demo_partner_bruno" model="res.partner">
            <field name="name">Bruno Práctica</field>
            <field name="email">bruno.practica@example.com</field>
        </record>

        <record id="demo_tag_nuevo" model="cd.practice.tag">
            <field name="name">Nuevo</field>
            <field name="color">1</field>
        </record>

        <record id="demo_tag_orm" model="cd.practice.tag">
            <field name="name">ORM</field>
            <field name="color">4</field>
        </record>

        <record id="demo_item_libro" model="cd.practice.item">
            <field name="name">Libro de ORM</field>
            <field name="description">Un libro para practicar dominios y recordsets.</field>
            <field name="owner_id" ref="demo_partner_ana"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_nuevo'), ref('demo_tag_orm')])]"/>
            <field name="price">25.0</field>
            <field name="quantity">2</field>
            <field name="state">available</field>
        </record>

        <record id="demo_item_teclado" model="cd.practice.item">
            <field name="name">Teclado mecánico</field>
            <field name="description">Ideal para escribir muchos search().</field>
            <field name="owner_id" ref="demo_partner_bruno"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_nuevo')])]"/>
            <field name="price">80.0</field>
            <field name="quantity">1</field>
            <field name="state">booked</field>
        </record>

        <record id="demo_item_monitor" model="cd.practice.item">
            <field name="name">Monitor 27''</field>
            <field name="owner_id" ref="demo_partner_ana"/>
            <field name="price">150.0</field>
            <field name="quantity">3</field>
            <field name="state">draft</field>
        </record>

        <record id="demo_line_libro_1" model="cd.practice.item.line">
            <field name="name">Capítulo 1</field>
            <field name="item_id" ref="demo_item_libro"/>
            <field name="quantity">1</field>
            <field name="price_unit">0.0</field>
        </record>

        <record id="demo_booking_ana" model="cd.practice.booking">
            <field name="name">Reserva de Ana</field>
            <field name="item_id" ref="demo_item_libro"/>
            <field name="partner_id" ref="demo_partner_ana"/>
            <field name="date_start" eval="Date.today()"/>
            <field name="date_end" eval="Date.today() + timedelta(days=7)"/>
            <field name="state">ongoing</field>
        </record>

        <record id="demo_booking_bruno" model="cd.practice.booking">
            <field name="name">Reserva de Bruno</field>
            <field name="item_id" ref="demo_item_teclado"/>
            <field name="partner_id" ref="demo_partner_bruno"/>
            <field name="date_start" eval="Date.today() - timedelta(days=10)"/>
            <field name="date_end" eval="Date.today() - timedelta(days=3)"/>
            <field name="state">done</field>
        </record>
    </data>
</odoo>
