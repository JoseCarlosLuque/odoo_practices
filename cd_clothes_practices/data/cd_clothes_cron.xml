<odoo>
    <data>
        <!-- =================================================================
             EJERCICIO 35b · Bloque 6 · Test: TestMailWizardCron.test_ex35_cron
             =================================================================
             Crea aquí el cron con xml id EXACTO
             ir_cron_cd_clothes_cancel_expired_orders que llame cada día a
             model._cron_cancel_expired_orders().
             PLANTILLA
               <record id="ir_cron_cd_clothes_cancel_expired_orders" model="ir.cron">
                   <field name="name">Tienda: cancelar pedidos caducados</field>
                   <field name="model_id" ref="model_cd_clothes_order"/>
                   <field name="state">code</field>
                   <field name="code">model._cron_cancel_expired_orders()</field>
                   <field name="interval_number">1</field>
                   <field name="interval_type">days</field>
               </record>
             OJO: en Odoo 19 ir.cron ya no tiene campo 'code' propio; lo hereda
             de ir.actions.server mediante _inherits, por eso se rellenan
             'name', 'model_id', 'state' y 'code' como en un server action.
             ================================================================= -->
    </data>
</odoo>
