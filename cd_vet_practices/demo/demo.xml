<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="demo_partner_ana" model="res.partner">
            <field name="name">Ana Veterinaria</field>
            <field name="email">ana.veterinaria@example.com</field>
        </record>

        <record id="demo_partner_bruno" model="res.partner">
            <field name="name">Bruno Veterinaria</field>
            <field name="email">bruno.veterinaria@example.com</field>
        </record>

        <record id="demo_tag_perro" model="cd.vet.tag">
            <field name="name">Perro</field>
            <field name="color">1</field>
        </record>

        <record id="demo_tag_gato" model="cd.vet.tag">
            <field name="name">Gato</field>
            <field name="color">4</field>
        </record>

        <record id="demo_pet_rocky" model="cd.vet.pet">
            <field name="name">Rocky</field>
            <field name="description">Un perro ideal para practicar dominios y recordsets.</field>
            <field name="owner_id" ref="demo_partner_ana"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_perro')])]"/>
            <field name="price">25.0</field>
            <field name="quantity">2</field>
            <field name="state">active</field>
        </record>

        <record id="demo_pet_misi" model="cd.vet.pet">
            <field name="name">Misi</field>
            <field name="description">Una gata que escribe muchos search().</field>
            <field name="owner_id" ref="demo_partner_bruno"/>
            <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_gato')])]"/>
            <field name="price">80.0</field>
            <field name="quantity">1</field>
            <field name="state">in_treatment</field>
        </record>

        <record id="demo_pet_luna" model="cd.vet.pet">
            <field name="name">Luna</field>
            <field name="owner_id" ref="demo_partner_ana"/>
            <field name="price">150.0</field>
            <field name="quantity">3</field>
            <field name="state">draft</field>
        </record>

        <record id="demo_treatment_rocky" model="cd.vet.treatment">
            <field name="name">Vacuna anual</field>
            <field name="pet_id" ref="demo_pet_rocky"/>
            <field name="quantity">1</field>
            <field name="price_unit">30.0</field>
        </record>

        <record id="demo_visit_ana" model="cd.vet.visit">
            <field name="name">Visita de Ana</field>
            <field name="pet_id" ref="demo_pet_rocky"/>
            <field name="partner_id" ref="demo_partner_ana"/>
            <field name="date_start" eval="datetime.today().date()"/>
            <field name="date_end" eval="datetime.today().date() + timedelta(days=7)"/>
            <field name="state">scheduled</field>
        </record>

        <record id="demo_visit_bruno" model="cd.vet.visit">
            <field name="name">Visita de Bruno</field>
            <field name="pet_id" ref="demo_pet_misi"/>
            <field name="partner_id" ref="demo_partner_bruno"/>
            <field name="date_start" eval="datetime.today().date() - timedelta(days=10)"/>
            <field name="date_end" eval="datetime.today().date() - timedelta(days=3)"/>
            <field name="state">done</field>
        </record>
    </data>
</odoo>
